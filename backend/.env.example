# SalesNeuro backend environment template.
# Copy this file to backend/.env and fill in your own keys.
# Never commit the real .env file.

# Tavily search API key (https://tavily.com/) — used by the OSINT agent for
# automated web searches against the target prospect.
TAVILY_API_KEY=your_tavily_key

# NVIDIA NIM API key (https://build.nvidia.com/) — used by LiteLLM for
# OpenAI-compatible chat completions powering the CrewAI agents.
NVIDIA_API_KEY=your_nvidia_nim_key

# Optional: override the chat model name routed through LiteLLM.
# NVIDIA_LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Optional: override the local ChromaDB persistence path used by ingest_rag.py.
# CHROMA_DB_PATH=.chroma
