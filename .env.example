# SalesNeuro environment template.
# Copy to .env at the repo root for shared values, or to backend/.env to scope
# secrets to the FastAPI process. The backend reads via python-dotenv.

# === Backend (FastAPI + CrewAI + LiteLLM) ===
# Anthropic Claude key, used by the CrewAI agents via LiteLLM by default.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Tavily key for the OSINT search agent.
# Get one at https://app.tavily.com/
TAVILY_API_KEY=""

# Optional: NVIDIA NIM key if you switch LiteLLM to an NVIDIA-hosted model.
# NVIDIA_API_KEY=""

# === Frontend (Next.js) ===
# Public base URL the Next.js app uses to reach the FastAPI backend.
NEXT_PUBLIC_API_BASE="http://localhost:8000"
